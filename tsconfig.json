{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleDetection": "legacy",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": false,
    "outDir": "static",
    "rootDir": "frontend",
    "noEmitOnError": true
  },
  "include": [
    "frontend/**/*.ts"
  ]
}
